# Copy to `agents_back/.env` and fill in. This file (the .example) is committed;
# the real `.env` is gitignored. Both agents_back (the headless `claude` engine)
# and platform_back load these — platform_back reads agents_back/.env directly.

# --- Atlassian / Confluence (source extraction + image downloads) ---
# Account email + API token from https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=your-atlassian-api-token
# Confluence site base URL (non-secret; used by the chat tutor's optional fallback).
CONFLUENCE_URL=https://your-site.atlassian.net

# --- Claude model for the headless engine (optional) ---
# Passed to `claude --model`; leave unset to use claude's configured default.
CLAUDE_MODEL=sonnet

# --- Podcast audio overview (OpenAI text-to-speech) ---
# Required to GENERATE podcasts (course build + chat work without it). Get a key
# at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional overrides for the two-host voices and the TTS model.
# Voices: alloy ash ballad coral echo fable nova onyx sage shimmer
# PODCAST_VOICE_HOST=onyx
# PODCAST_VOICE_COHOST=nova
# PODCAST_TTS_MODEL=gpt-4o-mini-tts
