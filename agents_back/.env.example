# Credentials for the source-extractor to download Confluence images via the
# media/attachment REST API (HTTP Basic auth). Copy to `.env` and fill in.
# `.env` is gitignored. create_course.py loads it on import, so both the CLI
# and api.py pass these through to the headless `claude` subprocess.

# Atlassian account email (the account that can view the Confluence space).
ATLASSIAN_EMAIL=you@omniaccess.com

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Model for the headless `claude` build turn (passed as --model). Subagents pin
# their own models in their .md frontmatter, so this sets the orchestrating turn
# only. Use opus/sonnet/haiku or a full model id. Leave unset for claude's default.
CLAUDE_MODEL=sonnet

# Confluence site base URL (NOT a secret). Used by the ported Albus chat tutor in
# platform_back for optional per-question reference retrieval via the REST API
# (<CONFLUENCE_URL>/wiki/rest/api/...). The tutor reuses ATLASSIAN_EMAIL/ATLASSIAN_API_TOKEN
# above as its Basic-auth credentials. If unset, the tutor answers from course content only.
CONFLUENCE_URL=https://your-site.atlassian.net